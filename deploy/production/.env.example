# ArcReel 生产环境配置（PostgreSQL）
# 复制为 .env 后填入你的值。本文件只作为 docker-compose.yml 的插值来源，不会挂进容器；
# 容器实际收到哪些变量以 docker-compose.yml 的 environment 为准。
# 修改本文件后执行 docker compose up -d 重建容器才会生效，docker compose restart 不会重新载入

# ============================================================
# 镜像与数据存放位置 (Image & Data)
# ============================================================
# 镜像标签（默认: latest）：latest 为最新正式版本，填版本号（如 0.36.0）则固定在该版本，
# 升级时再改这里；main 跟踪 main 分支最新构建，不建议用于生产
# ARCREEL_IMAGE_TAG=latest
# 宿主机上的数据存放位置（默认: 本目录）。下面会建立 projects/（项目与运行数据）、
# pgdata/（PostgreSQL 数据）与 claude_data/（Agent 会话数据）。相对路径以本目录为基准，
# 例如 /srv/arcreel。搬家时先停止服务，把这三个目录整个搬到新位置再改这里
# ARCREEL_HOST_DATA_DIR=.

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# 默认管理员的用户名与密码，只在第一次启动、还没有任何账号时使用；之后改密码、加成员都在
# 「设置 › 账号与成员」中进行，修改这两项不会再改动已有账号。忘记密码时用
# docker compose exec arcreel uv run python -m scripts.manage_users reset-password <用户名>
# 默认管理员用户名（默认: admin）
AUTH_USERNAME=admin
# 默认管理员密码（留空则生成初始密码，保存在数据存放位置的 projects/runtime/initial-admin-password）
AUTH_PASSWORD=
# JWT 签名密钥（留空则自动生成并保存到数据存放位置的 projects/runtime/auth-token-secret，重启后登录不失效；
# 在此设置时以设置值为准）
AUTH_TOKEN_SECRET=

# ============================================================
# PostgreSQL 配置
# ============================================================
# 数据库密码（必填，留空时 docker compose 拒绝启动）
# 仅使用字母数字，避免 URL 特殊字符（@#/?% 等）导致 DATABASE_URL 解析失败
# 生成方法: openssl rand -hex 16
POSTGRES_PASSWORD=

# ============================================================
# 日志配置 (Logging)
# ============================================================
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO

# ============================================================
# GPU 编码（可选）
# ============================================================
# 宿主机有 NVIDIA GPU 并装好 NVIDIA Container Toolkit 时，取消下一行注释，成片改用 GPU 编码。
# 没有 NVIDIA GPU 的主机保持注释，否则容器无法启动。
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
