{
  "name": "arcreel-frontend",
  "version": "0.35.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vp dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "knip": "knip",
    "build": "pnpm typecheck && vp build",
    "check": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm knip && vp test run",
    "preview": "vp preview",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "e2e": "playwright test",
    "e2e:server": "node e2e/run-server.ts",
    "e2e:remote": "PW_TEST_CONNECT_WS_ENDPOINT=ws://127.0.0.1:${E2E_SERVER_PORT:-3000}/ PW_TEST_CONNECT_EXPOSE_NETWORK='<loopback>' playwright test",
    "e2e:record": "node e2e/record-fixtures.ts",
    "doctor": "react-doctor"
  },
